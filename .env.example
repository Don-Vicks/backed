# Copy to .env at the repo root. The scripts, the web server and next.config.ts all read this one file;
# on a host (Railway) set the same names as service variables instead.

# --- Network: the one switch -------------------------------------------------
# localnet | devnet | mainnet. The browser bundle gets the network and its RPC at BUILD time
# (next.config.ts), so changing NETWORK or PUBLIC_RPC_URL needs a rebuild. /api/health returns 503
# when the running server and the build disagree.
NETWORK=devnet
# Server-side RPC per network; public endpoints are used when empty. DEVNET_RPC_URL and MAINNET_RPC_URL
# may carry an API key: they never reach the browser. LOCALNET_RPC_URL is also the browser RPC on
# localnet unless PUBLIC_RPC_URL is set.
# scripts/localnet/start.sh starts or reuses a validator with the mainnet Meteora programs (README, Localnet and CI).
LOCALNET_RPC_URL=http://127.0.0.1:8899
DEVNET_RPC_URL=
MAINNET_RPC_URL=
# RPC the browser uses. Shipped to every visitor, so only a keyless or domain-restricted URL.
# Empty = LOCALNET_RPC_URL on localnet, else the public endpoint for NETWORK.
PUBLIC_RPC_URL=

# --- Public origin -----------------------------------------------------------
# Canonical https origin of the deployed app, no trailing slash. It is written into immutable
# on-chain token metadata URIs and Blink icons. Required off localnet (falls back to
# https://$RAILWAY_PUBLIC_DOMAIN, which Railway sets itself); localnet falls back to the request URL.
# Makers sign in to their orders page on this host or on $RAILWAY_PUBLIC_DOMAIN; a signature made on
# any other host the app is reached on is refused.
PUBLIC_BASE_URL=

# Product photo storage (UploadThing, uploadthing.com). When set, photo uploads go to UploadThing and campaigns
# use its public https URLs, so uploads work anywhere (no PUBLIC_BASE_URL needed for photos). Server-only.
UPLOADTHING_TOKEN=
# Origins the app was served from before (comma-separated), after a domain change: campaigns listed
# under an old domain keep it on-chain, and still show as listed by this app.
PREVIOUS_BASE_URLS=

# --- Keys and mints ----------------------------------------------------------
# Platform (DBC partner) secret key as a JSON byte array or base58. Takes precedence over
# keys/<network>/platform.json. On devnet/localnet it must be the mock USDC mint authority (faucet).
PLATFORM_SECRET_KEY=
# Devnet/localnet only: TEST_KEYS_AUTOGEN=1 makes the server generate its own platform key and SHIPPING_KEY
# into keys/<network>/ the first time they are needed (keep that directory on a volume, e.g. PREORDER_ROOT
# on the volume), so no secret is pasted into the host's settings. The platform pubkey is logged once;
# fund it and make it the mock USDC mint authority. Ignored on mainnet.
TEST_KEYS_AUTOGEN=
# Pubkey written into each new campaign's DBC config as partner fee claimer and leftover receiver.
# Defaults to the platform key; use a cold wallet or multisig on mainnet. Configs are immutable, so
# set it before the first campaign.
PLATFORM_FEE_CLAIMER=
# Where `pnpm --filter @preorder/core platform:claim` sends claimed partner fees (USDC). Defaults to the
# fee claimer. Surplus and leftover always go to the fee claimer / leftover receiver in the config.
PLATFORM_TREASURY=
# Quote mint off mainnet. Takes precedence over keys/<network>/mock-usdc.json. On mainnet it must be
# empty or real USDC.
USDC_MINT=
# Wallet that funds the test wallets on devnet (scripts only; never commit the key file itself)
FUNDER_KEYPAIR=~/.config/solana/id.json

# --- Priority fees -------------------------------------------------------------
# Cap (micro-lamports per compute unit) on the priority fee added to wallet transactions: the p75 of
# recent fees on the accounts each one writes, at least 1000. Default 1000000. Not added on localnet.
PRIORITY_FEE_MAX_MICROLAMPORTS=

# --- Maker trust tier ----------------------------------------------------------
# Mainnet RPC for trust lookups (wallet history). Falls back to MAINNET_RPC_URL, then the public endpoint.
TRUST_RPC_URL=
# Localnet only, for tests: JSON map of wallet -> trust signals, e.g.
# {"<pubkey>": {"walletAgeDays": 800, "txCount": 900, "fundedByFreshWallet": false}}
# Ignored on devnet and mainnet.
TRUST_FIXTURES=
# Localnet only, for tests and the demo: replaces the trust-tier ship-window LP vesting schedule with a
# seconds-scale one, e.g. {"cliffSec": 20, "periods": 2, "periodSec": 10, "bpsPerPeriod": 2500}
# (50% of the maker's vesting LP at the cliff, then 25% every 10 s). Ignored on devnet and mainnet.
VESTING_SCHEDULE_OVERRIDE=

# --- Storage -----------------------------------------------------------------
# Directory of the SQLite store (backed.<network>.sqlite: campaigns, pending creates, token metadata,
# orders and pending redemptions, rate-limit buckets, faucet claims). Use an absolute path (a relative one is taken from the repo root). Deployed, point it
# at a persistent volume (Railway: volume at /app/data, DATA_DIR=/app/data, daily backups on), or a
# redeploy wipes it; on Railway /api/status checks it is under RAILWAY_VOLUME_MOUNT_PATH.
# Default <repo>/data. Holds no keys. Legacy <kind>.<network>.json files found there are imported once
# on first open: rows that don't validate are skipped and logged, files are renamed *.imported (or
# *.failed when unreadable), and a fully imported redemptions file is deleted (plaintext shipping data).
DATA_DIR=
# Encrypts shipping details at rest (AES-256-GCM): 32 bytes as 64 hex characters or base64, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required on mainnet (the server refuses to start without it) and on a deployed devnet (/api/health
# fails without it), so the key never sits next to the data it protects; localnet and a local devnet
# fall back to a public dev key and log a warning. A malformed key fails /api/health. To rotate, move
# the old key to SHIPPING_KEY_PREVIOUS: new rows use SHIPPING_KEY, old rows still open. Off mainnet,
# rows sealed with the dev key keep opening after SHIPPING_KEY is set. SHIPPING_ENCRYPTION_KEY is
# accepted as an alias (SHIPPING_KEY wins when both are set).
SHIPPING_KEY=
# Earlier SHIPPING_KEY values, comma-separated, tried in order when opening stored shipping details.
SHIPPING_KEY_PREVIOUS=

# --- Operations ----------------------------------------------------------------
# Bearer token for operator routes, at least 32 characters, e.g. openssl rand -hex 32:
# POST /api/admin/reconcile, and the platform-paid graduation path (POST /api/campaigns/<pool>/migrate
# with "Authorization: Bearer <token>"; everyone else gets a migrate tx their wallet pays).
# Unset or shorter = those routes are closed.
ADMIN_TOKEN=
# Seconds between the server's reconcile runs, which list pending campaigns whose pool landed but
# was never confirmed, expire builds that never landed (with their token metadata) and prune idle
# rate-limit buckets and old faucet claims (0 = off; pnpm core:reconcile runs it once).
RECONCILE_INTERVAL_SEC=600
# Seconds between store backups (a consistent copy into DATA_DIR/backups; 0 = off) and how many to keep.
# A backup sits on the same volume as the database: copy DATA_DIR/backups off the machine as well.
# pnpm core:backup writes one now; pnpm core:backup restore <file> restores one with the server stopped.
BACKUP_INTERVAL_SEC=3600
BACKUP_KEEP=24
# Where the server posts an alert (a Slack or Discord incoming webhook, https only) for a failed backup
# or a 5xx on an API route, at most one message per route every 5 minutes. Unset = no alerts.
ALERT_WEBHOOK_URL=
# /api/status reports not-ok when the platform key holds less SOL than this (default 0.1).
STATUS_MIN_PLATFORM_SOL=0.1

# --- Abuse limits --------------------------------------------------------------
# Proxies in front of the server that append to X-Forwarded-For. The client IP used for rate limits and
# faucet caps is the entry this many places from the right (the leftmost ones are client-supplied).
# 1 behind Railway's edge (default); 0 when nothing proxies (every request then shares one bucket):
# without a proxy, next start copies the socket address into X-Forwarded-For only when the client sent
# none, so the header is client-controlled. Anything but a whole number >= 0 fails /api/health.
TRUSTED_PROXY_HOPS=
# "off" disables the per-IP rate limits and the faucet caps, on localnet only (test runs from one IP).
RATE_LIMITS=

# --- Scripts -----------------------------------------------------------------
# Web app that src/scripts/api-smoke.ts and redeem-check.ts drive. Defaults to http://localhost:3100.
WEB_URL=

# --- Localnet scripts ----------------------------------------------------------
# Read by scripts/localnet/{start,stop,dump}.sh from the shell environment, not from this file (README,
# Localnet and CI). Defaults shown.
# RPC port of the validator to start or reuse (websocket = port + 1). Off 8899 the faucet, gossip and
# dynamic ports move next to it, so a second validator can run beside a shared one.
# LOCALNET_RPC_PORT=8899
# Ledger directory of a validator start.sh starts (default <repo>/.localnet/ledger-<port>, gitignored).
# LOCALNET_LEDGER=
# Directory written by dump.sh: start the validator from those files instead of cloning over RPC.
# LOCALNET_DUMPS=
# Cluster start.sh clones from and dump.sh dumps from.
# LOCALNET_CLONE_URL=https://api.mainnet-beta.solana.com
# Directory holding solana, solana-test-validator, if they are not on PATH.
# SOLANA_BIN=

# --- Paths -------------------------------------------------------------------
# Optional: directory holding keys/, .env and (without DATA_DIR) data/ instead of the repo root.
# pnpm core:seed:localnet seeds into it (a new temp dir when unset) and refuses one that already holds
# localnet keys or a mock USDC.
PREORDER_ROOT=
